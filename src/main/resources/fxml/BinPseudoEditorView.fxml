<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="root" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.giga.nexas.controller.BinPseudoEditorController"
            style="-fx-background-color: #f6f7fb;">
    <top>
        <VBox spacing="8.0">
            <padding>
                <Insets top="10.0" right="12.0" bottom="10.0" left="12.0"/>
            </padding>
            <Label fx:id="fileLabel" wrapText="true" maxWidth="Infinity" style="-fx-text-fill: #222222;"/>
            <HBox spacing="12.0" alignment="CENTER_LEFT">
                <HBox spacing="6.0" alignment="CENTER_LEFT">
                    <Label text="Mode" style="-fx-text-fill: #222222;"/>
                    <RadioButton fx:id="asmModeButton" text="ASM"/>
                    <RadioButton fx:id="pseudoModeButton" text="Pseudo"/>
                </HBox>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button fx:id="reloadButton" text="Reload"/>
                <Button fx:id="compileButton" text="Compile Back"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <VBox spacing="6.0">
            <HBox spacing="6.0" alignment="CENTER_LEFT" style="-fx-padding: 0 12 0 12;">
                <Label text="Search" style="-fx-text-fill: #222222;"/>
                <TextField fx:id="searchField" promptText="Search current view" HBox.hgrow="ALWAYS"/>
                <Button fx:id="searchPreviousButton" text="Previous"/>
                <Button fx:id="searchNextButton" text="Next"/>
                <Label fx:id="searchStatusLabel" minWidth="80.0" style="-fx-text-fill: #555555;"/>
            </HBox>
            <TextArea fx:id="pseudoArea" wrapText="false" VBox.vgrow="ALWAYS"
                      style="-fx-font-family: 'Consolas'; -fx-font-size: 12px; -fx-control-inner-background: white; -fx-text-fill: #111111;"/>
        </VBox>
    </center>
    <bottom>
        <Label fx:id="statusLabel" wrapText="true" maxWidth="Infinity" style="-fx-text-fill: #333333;">
            <BorderPane.margin>
                <Insets top="8.0" right="12.0" bottom="10.0" left="12.0"/>
            </BorderPane.margin>
        </Label>
    </bottom>
</BorderPane>
